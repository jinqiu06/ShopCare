# Copy to .env in the project root. Never commit actual credentials.
APP_NAME=ShopCare API
APP_VERSION=0.1.0
DATABASE_URL=sqlite:///./data/shopcare.db
LLM_API_KEY=
LLM_MODEL_ID=
LLM_BASE_URL=

# Embedding: an empty API key lets the embedding client reuse LLM_API_KEY.
EMBEDDING_API_KEY=
EMBEDDING_MODEL_ID=text-embedding-v4
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_DIMENSIONS=1024
